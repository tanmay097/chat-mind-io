# ===============================================
# ChatMind - Backend Environment Variables
# ===============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration (for session tokens)
JWT_SECRET=chatmind_super_secret_jwt_key_change_me_in_production
JWT_EXPIRE=30d
COOKIE_EXPIRE=30

# Supabase Configuration
# Get these values from your Supabase Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Cloudinary (legacy support)
CLOUDINARY_NAME=your_cloudinary_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# Optional MongoDB URI (if running legacy mongo backend)
DB_LINK=mongodb+srv://username:password@cluster.mongodb.net/chatmind
